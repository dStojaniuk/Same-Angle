{
  "files.associations": {
    "bun.lock": "jsonc"
  },
  "json.schemas": [
    {
      "fileMatch": [
        "/bun.lock"
      ],
      "schema": {
        "allowComments": true,
        "allowTrailingCommas": true
      }
    }
  ],
  "python.useEnvironmentsExtension": true,
  "python-envs.workspaceSearchPaths": [
    "backend/.venv"
  ],
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  }
}
