{
  "name": "@same-angle/backend",
  "private": true,
  "scripts": {
    "dev": "uv run --locked python -m uvicorn same_angle.api:app --host 127.0.0.1 --port 8765",
    "demo": "uv run --locked python examples/mask_demo.py",
    "format": "uv run --locked ruff format .",
    "format:check": "uv run --locked ruff format --check .",
    "lint": "uv run --locked ruff check .",
    "lint:fix": "uv run --locked ruff check --fix .",
    "typecheck": "uv run --locked mypy src examples tests",
    "test": "uv run --locked pytest -q",
    "check": "uv sync --locked && bun run format:check && bun run lint && bun run typecheck && bun run test"
  }
}
