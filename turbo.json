{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "CODEX_HOME",
        "ENABLE_CODEX_IMAGEGEN",
        "SAME_ANGLE_FLOOR_MODEL_FILE",
        "UV_NO_SYNC"
      ]
    },
    "demo": { "cache": false },
    "format": { "cache": false },
    "format:check": { "cache": false },
    "lint": { "cache": false },
    "lint:fix": { "cache": false },
    "check": { "cache": false }
  }
}
